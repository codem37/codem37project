import("//mojo/public/tools/bindings/mojom.gni")

# 1. Mojo Interface Definitions
mojom("mojom") {
  sources = [
    "cache/mojom/cache.mojom",
    "fetcher/mojom/fetcher.mojom",
    "shield/mojom/shield.mojom",
    "vault/mojom/vault.mojom",
  ]

  public_deps = [
    "//url/mojom:url_mojom_gurl",
  ]
}

# 2. Browser-Process Services (Vault, Shield, Fetcher, Protocols, Crypto, Migration, Cache, Compatibility, Diagnostics)
source_set("mine_services") {
  sources = [
    "cache/secure_local_cache_service.h",
    "cache/secure_local_cache_service_factory.cc",
    "cache/secure_local_cache_service_factory.h",
    "cache/secure_local_cache_service_impl.cc",
    "cache/secure_local_cache_service_impl.h",
    "compatibility/compatibility_override_manager.cc",
    "compatibility/compatibility_override_manager.h",
    "compatibility/user_agent_provider.cc",
    "compatibility/user_agent_provider.h",
    "crypto/secure_buffer.cc",
    "crypto/secure_buffer.h",
    "diagnostics/compatibility_diagnostics.cc",
    "diagnostics/compatibility_diagnostics.h",
    "fetcher/fetcher_service.h",
    "fetcher/fetcher_service_factory.cc",
    "fetcher/fetcher_service_factory.h",
    "fetcher/fetcher_service_impl.cc",
    "fetcher/fetcher_service_impl.h",
    "fetcher/segmented_fetch_producer.cc",
    "fetcher/segmented_fetch_producer.h",
    "migration/shield_data_migrator.cc",
    "migration/shield_data_migrator.h",
    "migration/vault_data_migrator.cc",
    "migration/vault_data_migrator.h",
    "protocols/mine_protocol_handler.cc",
    "protocols/mine_protocol_handler.h",
    "shield/shield_service.h",
    "shield/shield_service_factory.cc",
    "shield/shield_service_factory.h",
    "shield/shield_service_impl.cc",
    "shield/shield_service_impl.h",
    "shield/shield_url_loader_interceptor.cc",
    "shield/shield_url_loader_interceptor.h",
    "vault/vault_service.h",
    "vault/vault_service_factory.cc",
    "vault/vault_service_factory.h",
    "vault/vault_service_impl.cc",
    "vault/vault_service_impl.h",
  ]

  deps = [
    ":mojom",
    "//base",
    "//components/keyed_service/content",
    "//content/public/browser",
    "//crypto",
    "//url",
  ]
}

# 3. Privileged WebUI Controllers
source_set("mine_webui") {
  sources = [
    "webui/mine_settings_webui_controller.cc",
    "webui/mine_settings_webui_controller.h",
    "webui/shield_webui_controller.cc",
    "webui/shield_webui_controller.h",
    "webui/vault_webui_controller.cc",
    "webui/vault_webui_controller.h",
  ]

  deps = [
    ":mine_services",
    ":mojom",
    "//base",
    "//content/public/browser",
    "//ui/webui",
    "//url",
  ]
}

# 4. Security & Unit Verification Tests
source_set("mine_unittests") {
  testonly = true

  sources = [
    "cache/secure_local_cache_unittest.cc",
    "compatibility/compatibility_unittest.cc",
    "fetcher/fetcher_download_manager_unittest.cc",
    "fetcher/fetcher_service_unittest.cc",
    "fetcher/segmented_fetch_unittest.cc",
    "migration/vault_data_migrator_unittest.cc",
    "protocols/mine_protocol_handler_unittest.cc",
    "security/security_invariants_unittest.cc",
    "shield/shield_interceptor_unittest.cc",
    "shield/shield_service_unittest.cc",
    "vault/vault_service_unittest.cc",
    "webui/webui_security_unittest.cc",
  ]

  deps = [
    ":mine_services",
    ":mine_webui",
    ":mojom",
    "//base/test:test_support",
    "//content/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}
