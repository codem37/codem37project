import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "mine_settings"
  static_files = [ "mine_settings.html" ]
  non_web_component_files = [
    "mine_settings.ts",
    "app.ts",
    "mojo_client.ts",
    "components/theme_picker.ts",
    "components/data_controls.ts",
    "components/bookmarks_manager.ts",
  ]
  mojo_files = [
    "$root_gen_dir/mine/cache/mojom/cache.mojom-webui.ts",
  ]
  mojo_files_deps = [ "//mine:mojom_ts__generator" ]
}
