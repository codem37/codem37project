import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "mine_shield"
  static_files = [ "shield.html" ]
  non_web_component_files = [
    "shield.ts",
    "app.ts",
    "mojo_client.ts",
    "components/subscription_list.ts",
    "components/site_settings_panel.ts",
    "components/telemetry_panel.ts",
    "components/ruleset_status_card.ts",
  ]
  mojo_files = [
    "$root_gen_dir/mine/shield/mojom/shield.mojom-webui.ts",
  ]
  mojo_files_deps = [ "//mine:mojom_ts__generator" ]
}
