module codem37.fetcher.mojom;

import "url/mojom/url.mojom";

enum DownloadState {
  kInProgress,
  kPaused,
  kCompleted,
  kCancelled,
  kInterrupted,
};

// Snapshot representation of an active download.
// Renderers receive sanitized filenames, speed, and progress snapshots, never raw pointers or full paths.
struct DownloadItemSnapshot {
  uint64 download_id;
  url.mojom.Url url;
  string display_filename;
  int64 total_bytes;
  int64 received_bytes;
  DownloadState state;
  int32 percent_complete;
  int64 current_speed_bps;
  int64 estimated_time_remaining_sec;
  bool is_segmented;
  int64 start_time_unix;
};

// Push notification interface for WebUI download manager.
interface MineFetcherObserver {
  OnDownloadCreated(DownloadItemSnapshot snapshot);
  OnDownloadUpdated(DownloadItemSnapshot snapshot);
  OnDownloadDestroyed(uint64 download_id);
};

// Control-plane Mojo interface for native download lifecycle management.
interface MineFetcher {
  // Register an observer to receive push notifications of download updates (250ms coalesced).
  AddObserver(pending_remote<MineFetcherObserver> observer);

  // One-shot state reconciliation on WebUI reconnect or tab load.
  GetSnapshot() => (array<DownloadItemSnapshot> downloads);

  // Manual download initiation from WebUI control plane.
  StartFromUrl(url.mojom.Url url, string? suggested_filename) => (uint64 download_id);

  // Download lifecycle controls by opaque ID.
  Pause(uint64 download_id) => (bool success);
  Resume(uint64 download_id) => (bool success);
  Cancel(uint64 download_id) => (bool success);
  Remove(uint64 download_id) => (bool success);

  // Triggers native OS file manager to display the file (browser process executes this).
  OpenContainingFolder(uint64 download_id) => (bool success);
};
