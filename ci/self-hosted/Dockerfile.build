# Pinned Ubuntu 22.04 LTS Build Environment for codem37
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DEPOT_TOOLS_UPDATE=0

# Install build essentials and Chromium build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    bison \
    build-essential \
    ca-certificates \
    clang \
    curl \
    flex \
    git \
    git-lfs \
    gperf \
    libasound2-dev \
    libatk1.0-dev \
    libc6-dev \
    libcairo2-dev \
    libcups2-dev \
    libdbus-1-dev \
    libdrm-dev \
    libegl1-mesa-dev \
    libgbm-dev \
    libgl1-mesa-dev \
    libgles2-mesa-dev \
    libglib2.0-dev \
    libgtk-3-dev \
    libnss3-dev \
    libpango1.0-dev \
    libpulse-dev \
    libx11-dev \
    libxcomposite-dev \
    libxcursor-dev \
    libxdamage-dev \
    libxext-dev \
    libxfixes-dev \
    libxi-dev \
    libxrandr-dev \
    libxrender-dev \
    libxss-dev \
    libxtst-dev \
    ninja-build \
    python3 \
    python3-pip \
    sccache \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# Setup depot_tools
RUN git clone https://chromium.googlesource.com/chromium/tools/depot_tools.git /opt/depot_tools
ENV PATH="/opt/depot_tools:${PATH}"

WORKDIR /workspace

CMD ["/bin/bash"]
